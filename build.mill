//| mill-version: 1.1.5
//| mill-jvm-version: temurin:25
//| mill-jvm-opts: ["-XX:NonProfiledCodeHeapSize=250m", "-XX:ReservedCodeCacheSize=500m", "-Xss16m"]
//| mvnDeps: ["dev.propensive:crux-mill:0.1.4"]

package build

import mill.*
import scalalib.*
// `PomSettings`, `License`, `Developer`, `VersionControl`, `PublishModule` — the Maven publishing
// vocabulary, imported exactly as the Soundness build does (`scalalib.publish.*`).
import publish.*
// crux (propensive/crux): the pinned releases on GitHub, read directly as Coursier repositories.
import crux.*

object settings:
  // The compiler is the propensive Scala fork, Proscala, at this version: pinned in `deps` below
  // like the libraries and resolved from its GitHub release by crux, which also forces every
  // `org.scala-lang` artifact to it, since the pinned libraries name the release each was built
  // with. The fork stays TASTy-compatible across its patch releases, which is what every such
  // pin assumes.
  val scalaVersion = "3.10.0-pro-1.0.2"

  // This build's version. A release's version is declared once, by its tag: the release
  // (release.sh in propensive/.github) and a snapshot (snapshot.sh) both name it in
  // `FLARE_RELEASE_VERSION`. Any other build is the version after the latest release reachable
  // from HEAD — its patch version plus one, which sorts after that release and before whichever
  // follows it — or `0.0.1` where no release tag is reachable, as in CI's shallow checkout.
  // Called from `Task.Input`s, so the environment and the tags are read on every invocation.
  def version(env: Map[String, String]): String =
    env.get("FLARE_RELEASE_VERSION").filter(_.nonEmpty).getOrElse(nextVersion)

  def nextVersion: String =
    val root = mill.api.BuildCtx.workspaceRoot

    val latest: Option[String] =
      scala.util.Try:
        os.proc("git", "describe", "--tags", "--abbrev=0", "--match", "[0-9]*.[0-9]*.[0-9]*")
        . call(cwd = root, stderr = os.Pipe).out.text().trim
      . toOption

    def numeric(part: String): Boolean = part.nonEmpty && part.forall(_.isDigit)

    latest.collect:
      case s"$major.$minor.$patch" if Seq(major, minor, patch).forall(numeric) =>
        s"$major.$minor.${patch.toInt + 1}"
    . getOrElse("0.0.1")

  // The version this build of flare identifies itself as (`flare --version`, `flare about`, and
  // the `flare <version>` line of every census note): what `FLARE_RELEASE_VERSION` names (`make
  // snapshot` and the release both set it); otherwise the next version (`nextVersion`) with
  // the filtered tree hash of HEAD — the identity `make snapshot` would give this commit — and `-dirty` if
  // the working tree has changes that no commit records. Called from a `Task.Input`, so that
  // HEAD is consulted on every invocation.
  def buildVersion(env: Map[String, String]): String =
    env.get("FLARE_RELEASE_VERSION").filter(_.nonEmpty).getOrElse:
      val root = mill.api.BuildCtx.workspaceRoot

      val tree: String =
        scala.util.Try(os.proc("./etc/shared", "filtered_tree.py", "HEAD").call(cwd = root).out.text().trim)
          .getOrElse(os.proc("git", "rev-parse", "HEAD^{tree}").call(cwd = root).out.text().trim)

      val dirty: Boolean = os.proc("git", "status", "--porcelain").call(cwd = root).out.text().trim.nonEmpty
      s"$nextVersion-${tree.take(12)}${if dirty then "-dirty" else ""}"

  // The options the Soundness-based modules (`client`, `launcher`, `test`) compile with: the
  // fork's opt-in behaviours, capture checking, and the proscenium predef, exactly as flame.
  val scalaOptions = Seq(
    "-Zalias-captures",
    "-Zdiagnostic-givens",
    "-Zgiven-prefixes",
    "-Zinline-source-maps",
    "-Zopaque-mutability",
    "-Zpure-iarrays",
    "-Zfrozen-pure",
    "-Zretains-bounds",
    "-Zretains-skolems",
    "-Zspreadable-varargs",
    "-Zunboxed-pure-types",
    "-Zunion-captures",
    "-experimental",
    "-new-syntax",
    "-feature",
    "-preview",
    "-deprecation",
    "-Wunused:imports",
    "-Wimplausible-patterns",
    "-Xmax-inlines", "32",
    "-Yno-flexible-types",
    "-Yexplicit-nulls",
    "-Ycheck-all-patmat",
    "-language:experimental.modularity",
    "-language:experimental.dependent",
    "-language:experimental.relaxedLambdaSyntax",
    "-language:experimental.genericNumberLiterals",
    "-language:experimental.into",
    "-language:experimental.erasedDefinitions",
    "-language:implicitConversions",
    "-language:experimental.saferExceptions",
    "-language:experimental.strictEqualityPatternMatching",
    "-language:experimental.subCases",
    "-language:experimental.multiSpreads",
    // Capture checking, as enabled throughout Soundness. Separation checking is left off, as in
    // flame: the compiler-driving code threads `Tactic` capabilities through context-function
    // result types in a way the separation checker rejects.
    "-Ycc-new",
    "-language:experimental.captureChecking"
  )

  // The plugin's options: ordinary Scala with the stdlib predef, and no capture checking. The
  // plugin has no Soundness dependency — it is loaded into the compiler that builds Soundness —
  // so its sources are written for the standard library. `-Yexplicit-nulls` is load-bearing: the
  // sources use `.nn` throughout, and the compiler API they call returns nullable Java types.
  val pluginOptions = Seq(
    "-experimental",
    "-new-syntax",
    "-feature",
    "-deprecation",
    "-Wunused:imports",
    "-Yexplicit-nulls",
    // The language features the plugin's sources are written in. These are also what the
    // plugin's standalone parser must enable to parse code written in the same style; see
    // `flare.Parsing`.
    "-language:implicitConversions",
    "-language:experimental.modularity",
    "-language:experimental.dependent",
    "-language:experimental.relaxedLambdaSyntax",
    "-language:experimental.genericNumberLiterals",
    "-language:experimental.into",
    "-language:experimental.erasedDefinitions",
    "-language:experimental.saferExceptions",
    "-language:experimental.strictEqualityPatternMatching",
    "-language:experimental.subCases",
    "-language:experimental.multiSpreads"
  )

  // The proscenium predef (the soundness house predef) for the Soundness-based modules.
  // `scala` is deliberately NOT imported (as of Soundness #1693): the blessed collections are
  // proscenium's opaque `List`/`Set`/`Map`/`Array`, and naming both packages would make every
  // such reference ambiguous. Stdlib collections must announce themselves with an explicit
  // `scala.`-qualified name or import, and cross the boundary through `proscenium.compat`.
  val predef = Seq("-Yno-predef", "-Yimports:java.lang,proscenium")

  // Soundness publishes COMPONENTS (Soundness #1929): each tagged version is a GitHub release
  // whose assets are the individual component jars. Every released jar embeds its own POM and
  // ivy.xml (`META-INF/maven/…`), and `make sync-releases VERSION=X.Y.Z` in the Soundness
  // repository installs a release into `~/.ivy2/local`, from which coursier resolves these
  // coordinates with no repository configuration. Component jars carry no `_3` suffix, hence
  // the single-colon `mvn"…"`.
  //
  // Each list names TOP-LEVEL components only: each jar's embedded POM names its own
  // dependencies, so the rest of the surface `import soundness.*` touches arrives transitively.
  def component(soundness: String)(name: String): Dep = mvn"dev.propensive:$name:$soundness"

  def clientDeps(soundness: String) = Seq(
    "ethereal-core",             // the daemon
    "exoskeleton-completions",   // execute + tab-completion
    "exoskeleton-manpage",       // `flare install`'s manpage
    "galilei-jvm",               // the filesystem: source globs
    "kaleidoscope-core",         // Glob
    "stratiform-core",           // TEL: the configuration file and the census notes
    "escapade-core",             // Teletype output
    "escapade-io",
    "iridescence-core",          // colours
    "turbulence-stdio",          // Stdio
    "harlequin-core",            // syntax highlighting of excerpts
    "ambience-core",             // the environment
    "eucalyptus-core",           // logging
    "octogenarian-core", "octogenarian-cli", // git: notes, rev-parse, through the `git` command
    "guillotine-core",           // shelling out to git for the input tree
    "serpentine-core",           // paths
    "contingency-core",
    "gossamer-core",
    "burdock-core",              // externalize + the repackager
    "burdock-boot",              // the Bootstrap class the repackager force-includes
    "sibylline-core",            // the model: `flare assess` asks Anthropic through it
    "gastronomy-core",           // the rubric's digest
    "monotonous-core")           // the digest as hex
  . map(component(soundness))

  def recordsDeps(soundness: String) = Seq(
    "stratiform-core",           // TEL and BinTEL: the record codecs
    "contingency-core",
    "gossamer-core",
    "vacuous-core")
  . map(component(soundness))

  def pyrocosmDeps(pyrocosm: String) = Seq(
    mvn"dev.propensive:pyrocosm-model:$pyrocosm",
    mvn"dev.propensive:pyrocosm-terminal:$pyrocosm",
    mvn"dev.propensive:pyrocosm-compiler:$pyrocosm",
    mvn"dev.propensive:pyrocosm-web:$pyrocosm",          // the dashboard `flare serve` serves
    mvn"dev.propensive:pyrocosm-cli:$pyrocosm")

  // probably-events carries `probably.Streamer`, the BinTEL event stream fume drives a suite
  // through; without it fume falls back to a legacy run that no longer exists in 0.65.0.
  def testDeps(soundness: String) = Seq("probably-cli", "probably-events", "fulminate-core").map(component(soundness))

// The propensive libraries this build depends on, pinned in etc/refs (the format, the snapshot flow
// and the shared scripts are documented in propensive/.github): each is a release `X.Y.Z`, or a
// snapshot `X.Y.Z-<12 hex>` of an unreleased upstream build, published there by `make snapshot`.
// crux resolves each — and, transitively, what each was built against — from its GitHub release;
// nothing is installed locally. The Proscala pin is declared here rather than in etc/refs, which
// deps.py (propensive/.github) also reads and which does not yet know the form of a Proscala
// version. The file is read as a source, so editing it invalidates every resolution.
object deps extends CruxModule:
  def refsFiles = Task.Sources(mill.api.BuildCtx.workspaceRoot / "etc" / "refs")
  def declared = Seq(Pin("propensive/proscala", settings.scalaVersion))

  def soundness: T[String] = Task(version("soundness")())
  def pyrocosm: T[String] = Task(version("pyrocosm")())

// A module compiled with the pinned fork, against the pinned libraries.
trait Fork extends CruxScalaModule:
  def crux = deps

trait Project extends Module:
  def moduleDir = super.moduleDir / os.up / "src"

// Dependencies are typed `PublishModule*` (as in the Soundness build) so that `moduleDeps` can
// return `Seq[PublishModule]` — the type `SonatypeCentralPublishModule` requires of the modules that
// mix in `Publishing`. Flare's one inter-module dependency (`plugin`) is published, so
// this costs the unpublished modules (`launcher`, `test`) nothing.
trait Component(dependencies: PublishModule*) extends Fork:
  override def scalacOptions = settings.scalaOptions ++ settings.predef

  // The beneficence plugin writes `META-INF/givens/<typeclass>` and `META-INF/services/probably.Suite`
  // into every module that contributes an entry, so each is a *fragment* of a build-wide index rather
  // than a whole file. Mill's default assembly rules are last-one-wins, which silently truncates them:
  // now that flare's Soundness dependency arrives as eight bundle jars — which collide on 66 such
  // entries — the givens index would lose almost everything, and `beneficence` reads it at runtime
  // through `getResources`. Concatenate instead, exactly as the Soundness build does (`mergeRules`).
  // Every fragment ends with a newline, so the empty separator is correct.
  override def assemblyRules = super.assemblyRules ++ Seq(
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/givens/.*"),
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/services/.*"))
  def moduleId: String = moduleDir.last
  def moduleDeps: Seq[PublishModule] = dependencies
  def sources = Task.Sources(moduleDir)

// Mixed into the library modules that are released (`plugin`, `client`) — the modules the
// `launcher` then pulls back in as published coordinates. Releases go to GitHub Releases (see
// release.sh in propensive/.github), with `publishLocal` producing the jars and their
// POMs; the Sonatype module is retained only for its POM machinery. Every setting mirrors the
// Soundness build: the same `dev.propensive` organization, URL, Apache-2.0 licence, GitHub SCM and
// developer, plus the empty `-javadoc.jar`. A module's `moduleDeps` that are themselves
// `Publishing` become POM `<dependency>` entries, so the published `flare-client` correctly
// declares `flare-plugin`.
trait Publishing extends Fork, SonatypeCentralPublishModule:
  // A `Task.Input` reading `Task.env`, not a plain value: `FLARE_RELEASE_VERSION` is how a
  // release and `make snapshot` (release.sh and snapshot.sh in propensive/.github) drive the
  // version through a Mill daemon that is already running — the daemon freezes `sys.env` at its
  // own start, while `Task.env` is the environment of each `./mill` invocation. Without it, the
  // version is `settings.nextVersion`. The launcher resolves this module at this same version.
  def publishVersion = Task.Input:
    settings.version(Task.env)
  def artifactSuffix = Task("")

  def pomSettings = Task(PomSettings(
    description = "flare",
    organization = "dev.propensive",
    url = "https://propensive.dev/flare/",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("propensive", "flare"),
    developers = Seq(Developer("propensive", "Jon Pretty", "https://github.com/propensive"))))

  override def docJar = Task:
    val jar = Task.dest / "empty.jar"
    val zos = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(jar.toIO))
    zos.close()
    PathRef(jar)

// The plugin: the fork toolchain, but the plain scala predef and no capture checking, so its
// sources stay ordinary Scala and it pulls nothing of Soundness into the compiler it runs in.
trait PlainComponent(dependencies: PublishModule*) extends Fork:
  override def scalacOptions = settings.pluginOptions
  def moduleId: String = moduleDir.last
  def moduleDeps: Seq[PublishModule] = dependencies
  def sources = Task.Sources(moduleDir)

object flare extends Project:
  // The compiler plugin and the lint engine behind it (`flare.Linter`, which the `client` drives
  // too). `provided`: the compiler is present by definition wherever a compiler plugin runs, and
  // must not be dragged onto a consumer's classpath. Released as `dev.propensive:flare-plugin`.
  object plugin extends PlainComponent(), Publishing:
    def compileMvnDeps = Seq(mvn"org.scala-lang:scala3-compiler_3:${settings.scalaVersion}")
    def resources = Task.Sources(mill.api.BuildCtx.workspaceRoot / "res" / "plugin")

  // The records `flare assess` stores in git notes, with their BinTEL codecs, released as
  // `dev.propensive:flare-records`. Compiled WITHOUT capture checking, as Pyrocosm's `remote`
  // is: stratiform's derived TEL codecs expand to instances the capture checker sees as fresh
  // capabilities where a pure instance is required, so their derivation sites must sit in an
  // unchecked module. The client depends on it and only ever calls `encode`/`decode`.
  object records extends Component(), Publishing:
    def mvnDeps = Task(settings.recordsDeps(deps.soundness()))

    override def scalacOptions =
      (settings.scalaOptions ++ settings.predef).filterNot: option =>
        option == "-Ycc-new" || option == "-language:experimental.captureChecking"

  // The command-line client library (`flare.Client.run` and its helpers): reads the project's
  // configuration, drives the compiler over its sources, and renders what the engine finds. NOT
  // an assembled app: the `@main`/`externalize` entry point lives in the `launcher` module, so
  // this is a plain library released as `dev.propensive:flare-client`. Depends on `plugin`,
  // which becomes a `flare-plugin` POM dependency, and on the compiler it drives.
  object client extends Component(plugin, records), Publishing:
    def mvnDeps = Task:
      settings.clientDeps(deps.soundness()) ++ settings.pyrocosmDeps(deps.pyrocosm())
        :+ mvn"org.scala-lang:scala3-compiler_3:${settings.scalaVersion}"

    // Flare's own version, as `flare --version` and `flare about` report it and the census
    // records it: see `settings.buildVersion`. Written where Pyrocosm's `Tool` reads it.
    def buildVersion = Task.Input(settings.buildVersion(Task.env))

    override def resources = Task:
      val file = Task.dest / "META-INF" / "pyrocosm" / "flare" / "version"
      os.write.over(file, buildVersion() + "\n", createFolders = true)
      super.resources() ++ Seq(PathRef(Task.dest))

  // The invocation point, ALONE in its own module (`src/launcher/flare_launcher.scala` — just the
  // `object flare` whose `main` is `externalize(Client.run())`). It depends on `client`/`plugin` NOT as Mill
  // `moduleDeps` but as PUBLISHED coordinates, so coursier puts the byte-identical released jars
  // on the compile classpath that `externalize` hashes; the repackager then externalizes them into
  // on-demand downloads instead of inlining. `flare-client`'s POM pulls `flare-plugin` (and the
  // Soundness components) transitively; burdock is also named explicitly because the
  // `externalize` macro and the `soundness.repackage` main are compiled/run against it.
  //
  // NOTE: `flare-client` resolves from `~/.ivy2/local`, so a `publishLocal` must precede this
  // module's assembly (`make run` does so). Externalization happens only in a release, once
  // the same bytes are a GitHub release asset (a local copy alone would be inlined).
  object launcher extends Component():
    def mvnDeps = Task:
      mvn"dev.propensive:flare-client:${client.publishVersion()}" +: settings.clientDeps(deps.soundness())
    def finalMainClass = "flare.flare"
    // A clean zip (no executable shell preamble) so the Burdock repackager can read and rewrite the
    // assembled JAR.
    def prependShellScript = ""

  // The beneficence plugin runs on this module so that its `Suite` lands in the assembly's
  // `META-INF/services/probably.Suite` index, which is how `fume run` (configured by
  // .pyrocosm/fume/config.tel) discovers it. `flare.runTests` is the plain-`java` fallback the
  // shared CI workflow uses, driving `Tests.invoke` in-process. The suite drives the plugin's
  // parser directly, so it needs the compiler at runtime too. A `PlainComponent`, like the
  // plugin it tests: the suite is written against the standard library, as the plugin is.
  object test extends PlainComponent(plugin):
    def mvnDeps = Task:
      settings.testDeps(deps.soundness()) :+ mvn"org.scala-lang:scala3-compiler_3:${settings.scalaVersion}"
    def scalacPluginMvnDeps = Task(Seq(mvn"dev.propensive:beneficence-plugin:${deps.soundness()}"))
    def finalMainClass = "flare.runTests"
    override def assemblyRules = super.assemblyRules ++ Seq(
      mill.javalib.Assembly.Rule.AppendPattern("META-INF/givens/.*"),
      mill.javalib.Assembly.Rule.AppendPattern("META-INF/services/.*"))

// The release: the library modules' jars, each with its POM and ivy.xml embedded under
// `META-INF/maven/<group>/<artifactId>/`, named `<artifactId>-<version>.jar`, exactly as the
// Soundness and Pyrocosm builds stage theirs. A jar so staged is all a consumer needs: the shared
// sync script (propensive/.github) reconstructs the ivy2 layout coursier resolves from, which is
// how `make snapshot` publishes an unreleased build for a dependent repository to pin.
object release extends Module:
  def modules: Seq[PublishModule] = Seq(flare.plugin, flare.records, flare.client)

  private def withDescriptors(source: os.Path, target: os.Path, entries: Seq[(String, os.Path)])
  :   Unit =
    val input = new java.util.zip.ZipFile(source.toIO)
    val output = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(target.toIO))
    try
      val existing = input.entries()
      while existing.hasMoreElements do
        val entry = existing.nextElement()
        output.putNextEntry(new java.util.zip.ZipEntry(entry.getName))
        if !entry.isDirectory then input.getInputStream(entry).transferTo(output)
        output.closeEntry()

      for (name, file) <- entries do
        output.putNextEntry(new java.util.zip.ZipEntry(name))
        output.write(os.read.bytes(file))
        output.closeEntry()
    finally
      output.close()
      input.close()

  // The ivy.xml published beside each jar as `<artifactId>-<version>.ivy.xml`: the metadata
  // Coursier reads when crux (propensive/crux) uses the release as an Ivy-pattern repository,
  // without the sources and javadoc publications. Mill declares those in the `compile`
  // configuration too, and the crux artifact pattern names the main jar for any publication
  // without a classifier, so left in place they would resolve to the jar itself.
  private def stripDescriptor(ivy: String): String =
    val artifact = """<artifact\b[^>]*?(?:/>|>\s*</artifact>)""".r
    val filtered = artifact.replaceAllIn(ivy, found =>
      if found.matched.contains("classifier=") || found.matched.matches("""(?s).*\btype="(src|doc)".*""")
      then "" else java.util.regex.Matcher.quoteReplacement(found.matched))
    filtered.linesIterator.filter(_.trim.nonEmpty).mkString("", "\n", "\n")

  def stage: T[Seq[PathRef]] = Task:
    val jars: Seq[(PathRef, String, String, String, PathRef, PathRef)] =
      Task.traverse(modules)(module =>
        Task.Anon((module.jar(), module.pomSettings().organization, module.artifactId(),
                   module.publishVersion(), module.pom(), module.ivy())))()

    jars.flatMap: (jar, group, artifactId, version, pom, ivy) =>
      val target = Task.dest / s"$artifactId-$version.jar"
      val prefix = s"META-INF/maven/$group/$artifactId"
      val descriptors = Seq(s"$prefix/pom.xml" -> pom.path, s"$prefix/ivy.xml" -> ivy.path)
      withDescriptors(jar.path, target, descriptors)
      val metadata = Task.dest / s"$artifactId-$version.ivy.xml"
      os.write.over(metadata, stripDescriptor(os.read(ivy.path)))
      Seq(PathRef(target), PathRef(metadata))
