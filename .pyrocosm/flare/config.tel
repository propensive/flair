tel 1.0

# Flare checks flare, with the release pinned in etc/tools rather than the build under test —
# the tool rule, exactly as fume runs fume's suites. Every source is checked against Consequent
# Style, with the licence header every file begins with, and the rules below are measured by
# `flare metrics` commit by commit. `make check` runs the profile, and finds nothing; CI does
# not run it.

rule cast
  invokes asInstanceOf
  invokes isInstanceOf
  message  Casts bypass the type checker; prefer a pattern match

rule imperative
  uses var
  uses while
  uses null
  uses return

profile default
  source src/**/*.scala

  # The `-language` features the build compiles with, so flare parses the sources exactly as
  # the build does. The build enables relaxed lambda syntax with `-preview` instead, now that its
  # language import is deprecated, but a profile cannot pass `-preview` to flare's parser, so the
  # deprecated import is still how flare learns that `f: x => body` is a lambda: without it,
  # every one-line colon lambda fails to parse.
  language implicitConversions
  language experimental.modularity
  language experimental.dependent
  language experimental.relaxedLambdaSyntax
  language experimental.genericNumberLiterals
  language experimental.erasedDefinitions
  language experimental.saferExceptions
  language experimental.subCases
  language experimental.multiSpreads
  language experimental.captureChecking

  style consequent
    header etc/header.txt
    columns 100
    interpolator m
    interpolator e

  # `cast` is measured, not enforced. The plugin wraps dotty's own trees, where a cast into
  # `untpd`/`tpd` is how the API is used at all, and the client's compiler driver casts the
  # array it hands the driver; there are thirteen across the sources. Enforcing it here would
  # fail `make check` rather than describing where the project stands, which is what the census
  # is for.
